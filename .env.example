# Copy to .env.local for local development. Set the same values in
# Vercel → Project → Settings → Environment Variables for deployments.
# Never commit real values.

# ── Site ────────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap, Open Graph and auth emails.
NEXT_PUBLIC_SITE_URL=https://www.voltageafrica.africa

# ── Supabase (CMS, admin dashboard, media, contact inbox) ───────────────
# Supabase → Project Settings → API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe in the browser: Row Level Security
# limits it to published content.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security. Used only to store form
# submissions (partner, support, contact) and by scripts/create-admin.mjs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Engagement Inbox email notifications (Resend, https://resend.com) ───
# Optional. Without these, submissions are still stored in Supabase and
# appear in /admin/engagement; only the notification email is skipped.
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "VoltageAfrica <notifications@voltageafrica.africa>"
NOTIFICATION_FROM_EMAIL=
# Fallback recipient. The recipient set in Admin → Site settings →
# Engagement notifications takes precedence over this.
ADMIN_NOTIFICATION_EMAIL=
# Older names, still accepted: CONTACT_FROM_EMAIL (sender), CONTACT_TO_EMAIL (recipient)

# Optional salt for hashing visitor IP addresses (stored for abuse checks only)
IP_HASH_SALT=

# ── AI Energy Lab copilot (Anthropic Claude, https://console.anthropic.com) ─
# Optional. SERVER ONLY: read by app/api/energy-lab/copilot and never sent to
# the browser. Without a key the Energy Lab still works fully; the copilot then
# answers from its built-in engine (lib/energy-lab/fallback.ts), grounded in
# the same simulation results.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ENERGY_LAB_AI_MODEL=
# Set to "off" to force the built-in engine even when a key is present.
ENERGY_LAB_AI=
